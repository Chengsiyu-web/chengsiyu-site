---
import { site } from "../config";
const path = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const isActive = (p: string) =>
  p === "/" ? path === base + "/" : path.startsWith(base + p);

const links = [
  { href: "/", label: "首页", en: "INDEX" },
  { href: "/posts/", label: "文章", en: "WRITING" },
  { href: "/projects/", label: "项目", en: "WORK" },
  { href: "/about/", label: "关于", en: "ABOUT" },
];
const withBase = (href: string) => base + href;
---

<header class="nav">
  <nav class="nav-inner">
    <a href={withBase("/")} class="brand mono">{`${site.firstName} ${site.lastName}`.toUpperCase()}</a>
    <ul>
      {
        links.map((l) => (
          <li>
            <a
              href={withBase(l.href)}
              class:list={["mono", "nav-link", { active: isActive(l.href) }]}
              aria-current={isActive(l.href) ? "page" : undefined}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
    border-bottom: 1px solid var(--hairline);
    transition: background 0.3s var(--ease-out);
  }
  .nav.on-dark {
    background: var(--ink);
    border-bottom-color: var(--hairline-dark);
  }
  .nav.on-dark :global(.nav-link) { color: var(--gray-dim-dark); }
  .nav.on-dark :global(.nav-link.active),
  .nav.on-dark :global(.nav-link:hover) { color: var(--paper); }
  .nav.on-dark :global(.brand) { color: var(--paper); }
  .nav-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 40px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .brand { font-weight: 600; }
  ul { display: flex; gap: 32px; list-style: none; }
  .nav-link { position: relative; padding: 4px 0; color: var(--gray-mid); transition: color 0.2s var(--ease-out); }
  .nav-link:hover { color: var(--ink); }
  .nav-link.active { color: var(--ink); }
  @media (hover: hover) and (pointer: fine) {
    .nav-link::after {
      content: ""; position: absolute; left: 0; bottom: -2px; width: 100%; height: 2px;
      background: var(--pink); transform: scaleX(0); transform-origin: left;
      transition: transform 0.24s var(--ease-out);
    }
    .nav-link:hover::after, .nav-link.active::after { transform: scaleX(1); }
  }
  @media (max-width: 768px) {
    .nav-inner { padding: 0 20px; height: 56px; }
    ul { gap: 20px; }
  }
</style>
