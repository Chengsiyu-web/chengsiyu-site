---
// My Thinking（1:1 复刻老 Portfolio 布局比例——参数取自其源码）：
// work-views: max-width 960 / margin auto / padding 0 3rem 2.5rem
// heading: label(0.62rem 大写) + flex:1 横线 + title(clamp 1.8-2.6rem serif 400)
// item: padding 1.6rem 0 + hairline 顶线 / tag 0.92rem 500 / body 0.82rem 1.75
// 容器在屏内垂直居中（justify-content: center）
// 新条目往 MUSINGS 数组里加。
const MUSINGS = [
  {
    cap: "AI PM 的核心价值",
    text: "AI 产品经理的价值，不在于懂多少技术，而在于判断需求、选择合适的技术栈，知道何时让技术介入。既不能造出没人用的「AI 功能」，也不能只做不考虑技术边界的交互稿——更重要的是想清楚：用户应该看见什么，不应该看见什么。封装层的边界，决定了产品的气质。",
  },
  {
    cap: "Agent 狂潮的背后",
    text: "当所有产品都要加上 Agent 的时候，我觉得更重要的是：需求场景是否存在？是否一定要用 Agent 解决？真正值得用 Agent 的，是必须伸手去拿外部工具、需要让模型去思考完成路径的任务。",
  },
  {
    cap: "关于 AI 的商业真相",
    text: "学商科让我养成了一个习惯：先找到钱从哪来，再谈改变世界。任何业务都可以站在宏观的角度思考，用跨行业的视角来辅助理解——无论什么载体（短视频、小说、短剧）背后都是内容分发与消费，思路可以共通。AI 业务也逃不开这个底层逻辑：模型可以租，但商业场景不能借。空烧 token 不是创新，找到真实锚点，护城河才有地基。",
  },
];
---

<div class="work-views">
  <div class="wv-heading">
    <div class="wv-heading-label">What I believe about building with AI.</div>
    <div class="wv-heading-line"></div>
    <div class="work-title">My Thinking</div>
  </div>
  {
    MUSINGS.map((m) => (
      <div class="work-view-item reveal reveal-blur">
        <div class="work-view-tag">
          <span>{m.cap}</span>
        </div>
        <div class="work-view-body-wrap">
          <div class="work-view-body">{m.text}</div>
        </div>
      </div>
    ))
  }
</div>

<style>
  .work-views {
    max-width: 960px;
    width: 100%;
    margin: 0 auto;
    padding: 0 3rem 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* 标题区：左侧小标 + flex 横线 + 右侧衬线标题（源：work-views-heading） */
  .wv-heading {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    padding: 1.4rem 0 0.6rem;
    margin-bottom: 1.5rem;
  }
  .wv-heading-label {
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gray-light);
    white-space: nowrap;
  }
  .wv-heading-line {
    flex: 1;
    height: 1px;
    background: var(--hairline);
  }
  .work-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    font-weight: 400;
    color: var(--ink);
    line-height: 1.2;
    white-space: nowrap;
  }

  .work-view-item {
    padding: 1.6rem 0;
    border-top: 1px solid var(--hairline);
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .work-view-item:last-child {
    border-bottom: 1px solid var(--hairline);
  }
  .work-view-tag {
    font-size: 15px;
    font-weight: 500;
    color: var(--ink);
  }
  /* Underline Reveal 动效（1:1：pink 1.5px 左起 scaleX 0.38s） */
  .work-view-tag span {
    display: inline-block;
    position: relative;
    cursor: default;
  }
  .work-view-tag span::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 1.5px;
    background: var(--pink-deep);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.38s var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .work-view-item:hover .work-view-tag span::after { transform: scaleX(1); }
  }
  .work-view-body {
    font-size: 0.82rem;
    color: var(--gray-mid);
    line-height: 1.75;
  }

  @media (max-width: 768px) {
    .work-views { padding: 0 1.2rem 1.5rem; }
    .wv-heading { flex-wrap: wrap; gap: 0.8rem; }
  }
</style>
