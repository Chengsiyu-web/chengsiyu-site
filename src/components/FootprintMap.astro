---
// 足迹地图：dotted-map 生成的世界点阵（scripts/gen-footprint-map.mjs）
// 27 城市级 pin。国家标签常显，hover 展开该国城市清单；意大利（交换学年）呼吸强调。
// 改去过的地方：改 scripts/gen-footprint-map.mjs 的 PINS + 本文件 COUNTRIES，重跑脚本。
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const COUNTRIES = [
  {
    name: "CHINA", x: 83.5, y: 41.4, anchor: "left",
    cities: ["北京", "济南", "大连", "上海", "杭州", "泉州", "福州", "广州", "香港", "成都", "重庆", "大理", "腾冲"],
  },
  { name: "JAPAN", x: 91.8, y: 37.7, anchor: "left", cities: ["东京", "京都", "大阪"] },
  { name: "ITALY", x: 53.3, y: 33.9, anchor: "right", pulse: true, cities: ["罗马", "佛罗伦萨", "威尼斯", "米兰", "交换一学年"] },
  { name: "FRANCE", x: 51.6, y: 32.0, anchor: "right", cities: ["巴黎", "尼斯（南法）"] },
  { name: "SPAIN", x: 51.1, y: 33.9, anchor: "right", cities: ["巴塞罗那"] },
  { name: "CZECH", x: 54.4, y: 26.4, anchor: "left", cities: ["布拉格"] },
  { name: "HUNGARY", x: 56.0, y: 28.2, anchor: "left", cities: ["布达佩斯"] },
  { name: "DENMARK", x: 53.8, y: 20.7, anchor: "left", cities: ["哥本哈根"] },
  { name: "ICELAND", x: 43.4, y: 11.3, anchor: "left", cities: ["雷克雅未克"] },
];
---

<div class="footprint">
  <div class="fp-label">足迹👣</div>
  <div class="fp-map">
    <img src={`${base}/images/footprint-map.svg`} alt="世界点阵地图，标记去过的地方" class="fp-svg" loading="lazy" />
    {
      COUNTRIES.map((c) => (
        <div class={`fp-country ${c.anchor === "right" ? "anchor-right" : ""}`} style={`left:${c.x}%;top:${c.y}%`}>
          {c.pulse && <span class="fp-pulse-dot" aria-hidden="true" />}
          <span class="fp-country-name mono">{c.name}</span>
          <span class="fp-cities">
            {c.cities.map((city) => <i>{city}</i>)}
          </span>
        </div>
      ))
    }
  </div>
  <div class="fp-hint mono">· 去过的地方 · 9 国 27 城，慢慢补全</div>
</div>

<style>
  .footprint { margin-top: 8px; }
  .fp-label { color: var(--gray-mid); margin-bottom: 10px; display: block; font-size: 17px; }
  .fp-map {
    position: relative;
    background: var(--bg-warm);
    border: 1px solid var(--hairline);
    border-radius: 8px;
    padding: 24px 16px 20px;
  }
  .fp-svg { width: 100%; height: auto; display: block; }

  /* 国家标签：锚在 pin 上，anchor 决定往左还是往右展开 */
  .fp-country {
    position: absolute;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    gap: 6px;
    cursor: default;
  }
  .fp-country.anchor-right {
    transform: translate(-100%, -50%);
    flex-direction: row-reverse;
  }
  .fp-country-name {
    color: var(--gray-mid);
    font-size: 10px;
    letter-spacing: 0.16em;
    transition: color 0.24s var(--ease-out);
  }
  .fp-country:hover .fp-country-name { color: var(--pink-deep); }

  /* 意大利主场：呼吸圆点 */
  .fp-pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--pink-deep);
    box-shadow: 0 0 0 3px rgba(184, 128, 128, 0.3);
    animation: poiPulse 2.2s ease infinite;
    flex: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .fp-pulse-dot { animation: none; }
  }
  @keyframes poiPulse {
    0%, 100% { box-shadow: 0 0 0 3px rgba(184, 128, 128, 0.3); }
    50% { box-shadow: 0 0 0 7px rgba(184, 128, 128, 0.1); }
  }

  /* hover 城市清单 */
  .fp-cities {
    display: none;
    position: absolute;
    top: -8px;
    background: var(--ink);
    padding: 10px 14px;
    border-radius: 4px;
    z-index: 2;
    white-space: nowrap;
    max-width: 260px;
    flex-wrap: wrap;
    gap: 2px 10px;
  }
  .fp-country:not(.anchor-right) .fp-cities { left: calc(100% + 10px); }
  .fp-country.anchor-right .fp-cities { right: calc(100% + 10px); }
  .fp-cities i {
    font-style: normal;
    color: var(--gray-dim-dark);
    font-size: 11.5px;
    display: inline-block;
  }
  .fp-cities i:first-child { color: var(--paper); }
  @media (hover: hover) and (pointer: fine) {
    .fp-country:hover .fp-cities { display: inline-flex; }
  }

  .fp-hint { color: var(--gray-mid); margin-top: 10px; font-size: 11px; letter-spacing: 0.06em; }

  @media (max-width: 768px) {
    .fp-cities { display: none !important; }
  }
</style>
