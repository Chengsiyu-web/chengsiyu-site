---
// 足迹地图：区域高亮（scripts/gen-footprint-map.mjs 生成的国界多边形）。
// 9 个到访国柔粉填充，hover 国家弹出城市清单；意大利保留呼吸点。
// 改去过的地方：改 scripts/gen-footprint-map.mjs 的 VISITED/PINS + 本文件 COUNTRIES，重跑脚本。
import { readFileSync } from "node:fs";
const svg = readFileSync("public/images/footprint-map.svg", "utf8");

const COUNTRIES = [
  { cc: "CHN", name: "中国", cities: ["北京", "济南", "大连", "上海", "杭州", "泉州", "福州", "广州", "香港", "成都", "重庆", "大理", "腾冲"] },
  { cc: "JPN", name: "日本", cities: ["东京", "京都", "大阪"] },
  { cc: "ITA", name: "意大利", note: "交换一学年", cities: ["罗马", "佛罗伦萨", "威尼斯", "米兰"] },
  { cc: "FRA", name: "法国", cities: ["巴黎", "尼斯（南法）"] },
  { cc: "ESP", name: "西班牙", cities: ["巴塞罗那"] },
  { cc: "CZE", name: "捷克", cities: ["布拉格"] },
  { cc: "HUN", name: "匈牙利", cities: ["布达佩斯"] },
  { cc: "DNK", name: "丹麦", cities: ["哥本哈根"] },
  { cc: "ISL", name: "冰岛", cities: ["雷克雅未克"] },
];
---

<div class="footprint">
  <p class="mono fp-label">足迹👣</p>
  <div class="fp-map">
    <div class="fp-svg" set:html={svg} />
    <div class="fp-tip" data-tip hidden>
      <span class="fp-tip-name"></span>
      <span class="fp-tip-cities"></span>
    </div>
  </div>
  <div class="fp-hint mono">· 去过的地方 · 9 国 27 城，慢慢补全</div>
</div>

<script define:vars={{ COUNTRIES }}>
  const map = document.querySelector(".fp-map");
  const tip = map.querySelector("[data-tip]");
  const tipName = tip.querySelector(".fp-tip-name");
  const tipCities = tip.querySelector(".fp-tip-cities");

  for (const p of map.querySelectorAll(".fp-visited")) {
    p.addEventListener("mouseenter", () => {
      const c = COUNTRIES.find((c) => c.cc === p.dataset.cc);
      if (!c) return;
      tipName.textContent = c.note ? `${c.name} · ${c.note}` : c.name;
      tipCities.textContent = c.cities.join(" / ");
      tip.hidden = false;
      const pr = p.getBoundingClientRect();
      const mr = map.getBoundingClientRect();
      const tw = tip.offsetWidth;
      let x = pr.left - mr.left + pr.width / 2;
      x = Math.max(tw / 2 + 6, Math.min(x, mr.width - tw / 2 - 6));
      tip.style.left = `${x}px`;
      const above = pr.top - mr.top > tip.offsetHeight + 16;
      tip.classList.toggle("below", !above);
      tip.style.top = `${above ? pr.top - mr.top - 10 : pr.bottom - mr.top + 10}px`;
    });
    p.addEventListener("mouseleave", () => {
      tip.hidden = true;
    });
  }
</script>

<style>
  .footprint { margin-top: 8px; }
  .fp-label { color: var(--gray-mid); margin-bottom: 14px; display: block; font-size: 17px; }
  .fp-map {
    position: relative;
    background: var(--bg-warm);
    border: 1px solid var(--hairline);
    border-radius: 8px;
    padding: 22px 16px 18px;
  }
  .fp-hint { color: var(--gray-mid); margin-top: 10px; font-size: 11px; letter-spacing: 0.06em; }

  .fp-tip {
    position: absolute;
    transform: translate(-50%, -100%);
    background: var(--ink);
    padding: 9px 14px;
    border-radius: 4px;
    z-index: 2;
    white-space: nowrap;
    pointer-events: none;
    box-shadow: 0 6px 18px rgba(42, 36, 32, 0.18);
  }
  .fp-tip.below { transform: translate(-50%, 0); }
  .fp-tip-name {
    color: var(--paper);
    font-size: 12px;
    display: block;
    margin-bottom: 3px;
  }
  .fp-tip-cities { color: var(--gray-dim-dark); font-size: 11.5px; }
</style>

<style is:global>
  /* SVG 由构建脚本注入（set:html 不走 scoped 处理），填色在这里统一定义 */
  .fp-svg svg { width: 100%; height: auto; display: block; }
  .fp-land { fill: #E9E3DA; }
  .fp-visited {
    fill: #EDD5D5;
    stroke: rgba(184, 128, 128, 0.4);
    stroke-width: 0.6;
    transition: fill 0.24s var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .fp-visited:hover { fill: #E2C3C3; }
  }
  .fp-city { fill: #B88080; pointer-events: none; }
  .fp-pulse-core { fill: #B88080; pointer-events: none; }
  .fp-pulse-halo {
    fill: none;
    stroke: #B88080;
    stroke-width: 1.1;
    pointer-events: none;
    transform-box: fill-box;
    transform-origin: center;
    animation: fpHalo 2.4s var(--ease-out) infinite;
  }
  @keyframes fpHalo {
    0% { transform: scale(0.35); opacity: 0.55; }
    70% { transform: scale(1); opacity: 0; }
    100% { transform: scale(1); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fp-pulse-halo { animation: none; opacity: 0.18; }
  }
  @media (hover: none) {
    .fp-tip { display: none !important; }
  }
</style>
