---
// 足迹地图：意大利交换 + 南法走过的城市（源：老 Portfolio 未完成的 tmi-map 设计，在此做完）
const PLACES = [
  { name: "罗马", en: "Roma", x: 47.5, y: 62, note: "交换学年 · Luiss" },
  { name: "米兰", en: "Milano", x: 40, y: 38, note: "时装周与大教堂" },
  { name: "威尼斯", en: "Venezia", x: 55, y: 32, note: "水城的雨季" },
  { name: "佛罗伦萨", en: "Firenze", x: 46, y: 55, note: "文艺复兴的原点" },
  { name: "那不勒斯", en: "Napoli", x: 53.5, y: 75, note: "披萨与海湾" },
  { name: "南法", en: "Côte d'Azur", x: 32, y: 63, note: "最澄澈的海" },
];
---

<div class="footprint">
  <div class="mono fp-label">FOOTPRINTS · 交换那一年走过的城市</div>
  <div class="fp-map">
    <svg viewBox="0 0 100 88" class="fp-svg" role="img" aria-label="欧洲西南部示意地图，标注走过六个城市">
      <!-- 伊比利亚半岛 -->
      <path d="M6 30 L10 22 L22 18 L28 24 L27 34 L22 44 L14 46 L8 40 Z" />
      <!-- 法国 -->
      <path d="M22 18 L28 24 L34 22 L38 28 L36 38 L40 44 L36 52 L30 56 L27 44 L22 44 Z" />
      <!-- 意大利（靴形，理想化简笔） -->
      <path d="M42 34 L48 32 L50 38 L56 36 L58 42 L54 48 L56 54 L58 60 L55 66 L52 62 L49 56 L46 52 L44 44 Z" />
      <path d="M55 66 L58 66 L60 72 L57 76 L55 71 Z" />
      <!-- 阿尔卑斯以北的中欧一角 -->
      <path d="M36 14 L46 12 L56 14 L58 22 L52 30 L44 32 L38 28 L34 22 Z" />
      <!-- 亚得里亚海东岸 -->
      <path d="M58 42 L64 44 L66 52 L62 58 L58 60 L58 52 Z" />
    </svg>
    {PLACES.map((p) => (
      <div class="fp-poi" style={`left:${p.x}%;top:${p.y}%`}>
        <span class="fp-poi-dot"></span>
        <span class="fp-poi-label">
          <b>{p.name}</b>
          <i>{p.note}</i>
        </span>
      </div>
    ))}
  </div>
  <div class="fp-hint mono">· 意大利十几个城市的完整足迹，慢慢补全</div>
</div>

<style>
  .footprint { margin-top: 8px; }
  .fp-label { color: var(--gray-mid); margin-bottom: 10px; display: block; }
  .fp-map {
    position: relative;
    background: var(--paper);
    border: 1px solid var(--hairline);
    border-radius: 8px;
    padding: 20px 12px 8px;
  }
  .fp-svg { width: 100%; height: auto; display: block; }
  .fp-svg path {
    fill: none;
    stroke: var(--hairline);
    stroke-width: 0.7;
    stroke-linejoin: round;
  }
  .fp-poi {
    position: absolute;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
  }
  .fp-poi-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--pink);
    box-shadow: 0 0 0 3px rgba(242, 184, 198, 0.35);
    animation: poiPulse 2.2s ease infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .fp-poi-dot { animation: none; }
  }
  @keyframes poiPulse {
    0%, 100% { box-shadow: 0 0 0 3px rgba(242, 184, 198, 0.35); }
    50% { box-shadow: 0 0 0 7px rgba(242, 184, 198, 0.12); }
  }
  .fp-poi-label {
    display: none;
    position: absolute;
    bottom: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    background: var(--ink);
    padding: 6px 10px;
    border-radius: 4px;
    z-index: 2;
  }
  .fp-poi-label b { display: block; color: var(--paper); font-size: 12px; font-weight: 600; }
  .fp-poi-label i { display: block; color: var(--gray-dim-dark); font-size: 10.5px; font-style: normal; margin-top: 1px; }
  @media (hover: hover) and (pointer: fine) {
    .fp-poi:hover .fp-poi-label { display: block; }
  }
  .fp-hint { color: var(--gray-mid); margin-top: 10px; font-size: 11px; letter-spacing: 0.06em; }
</style>
