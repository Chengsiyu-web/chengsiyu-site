---
// Hero 右侧个人照轮播：两侧渐隐聚焦式（jitter "Interactive Gallery" 的网页翻译）
// 中央照片原尺寸清晰，两侧照片 scale/opacity/blur 连续衰减；3s 步进 + lerp 平滑，
// hover 任意照片滑到正中并暂停，1.2s 后恢复；双份渲染无缝循环。
// 换照片：替换 public/images/gallery/ 下的文件并改 PHOTOS（竖构图最佳）。
const PHOTOS = [
  { src: "/images/gallery/03d4835b5b40b2bc16a36b161d7614fc.jpg", alt: "个人照一" },
  { src: "/images/gallery/0b707d013dcce8cddc479128aaa8c614.jpg", alt: "个人照二" },
  { src: "/images/gallery/512e7c57a729804b0fcb0072168d3c5b.jpg", alt: "个人照三" },
  { src: "/images/gallery/971d41cea24a2a9b8423b2853bdac30a.jpg", alt: "个人照四" },
  { src: "/images/gallery/b7a295706b139d600cbbd5c85ae09db3.jpg", alt: "个人照五" },
  { src: "/images/gallery/d0230f2ded70f51dc883862d454cc4ce.jpg", alt: "个人照六" },
  { src: "/images/gallery/e995a7d1903948eab41c4d0c1bb716df.jpg", alt: "个人照七" },
  { src: "/images/gallery/22810c47c9b788f15518438905eb62c3.jpg", alt: "个人照八" },
];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<div
  class="carou"
  role="region"
  aria-roledescription="照片轮播"
  aria-label="个人照片"
  data-carousel
>
  {
    PHOTOS.concat(PHOTOS).map((p, i) => (
      <button class="slide" data-i={i} aria-hidden="true" tabindex="-1">
        <img src={`${base}${p.src}`} alt={p.alt} loading={i < 3 ? "eager" : "lazy"} draggable="false" />
      </button>
    ))
  }
</div>

<script>
  const root = document.querySelector("[data-carousel]");
  if (root) {
    const slides = Array.from(root.querySelectorAll(".slide"));
    const N = slides.length / 2; // 双份渲染，真实张数为一半
    const REDUCED = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const SP = 252;          // 相邻照片中心间距（px，容器坐标系）
    const LERP = 0.085;
    const AUTO_MS = 3000;
    const RESUME_MS = 1200;

    let pos = 0, tPos = 0;
    let paused = false, resumeTimer = 0, last = performance.now();

    const auto = REDUCED ? 0 : setInterval(() => { if (!paused) tPos += 1; }, AUTO_MS);

    slides.forEach((el, i) => {
      el.addEventListener("mouseenter", () => {
        // 滑动未结束时忽略新 hover，防止路过的照片劫持目标
        if (Math.abs(tPos - pos) > 0.08) return;
        paused = true;
        clearTimeout(resumeTimer);
        tPos = i + N * Math.round((pos - i) / N); // 就近环绕
      });
      el.addEventListener("mouseleave", () => {
        resumeTimer = setTimeout(() => { paused = false; }, RESUME_MS);
      });
    });

    const clamp01 = (v) => Math.max(0, Math.min(1, v));

    function frame(now) {
      const dt = Math.min(50, now - last);
      last = now;
      const k = REDUCED ? 1 : 1 - Math.pow(1 - LERP, dt / 16.667);
      pos += (tPos - pos) * k;
      if (Math.abs(tPos - pos) < 0.001) pos = tPos;

      // 中心照片在容器中心；d<0（左侧）时衰减更快且最多露出一张半透明近照——
      // Hero 里标题在左，溢出预算只在右侧
      const cx = root.clientWidth / 2, cy = root.clientHeight / 2;
      for (let i = 0; i < slides.length; i++) {
        let d = ((i - pos) % (N * 2) + N * 2) % (N * 2);
        if (d > N) d -= N * 2;
        const neg = d < 0 ? d * 1.6 : 0;
        const dd = d + neg * 0.85; // 左侧衰减加速
        const ad = Math.abs(dd);
        const scale = Math.max(0.05, 1 - 0.16 * ad);
        const op = ad <= 0.9 ? 1 : clamp01(1 - (ad - 0.9) / 1.6);
        const blur = REDUCED ? 0 : Math.min(5 * ad, 12);
        const el = slides[i];
        el.style.transform =
          `translate(${(cx + dd * SP).toFixed(1)}px, ${cy}px) translate(-50%, -50%) scale(${scale.toFixed(3)})`;
        el.style.opacity = op.toFixed(3);
        el.style.filter = blur > 0.05 ? `blur(${blur.toFixed(1)}px)` : "none";
        el.style.zIndex = String(100 - Math.round(ad * 10));
        el.style.pointerEvents = op > 0.1 ? "auto" : "none";
      }
      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  }
</script>

<style>
  .carou {
    position: relative;
    width: 27rem;
    flex: none;
    height: 33rem;
    overflow: visible; /* 两侧渐隐照片允许溢出容器，由 Hero 层裁剪 */
  }
  .slide {
    position: absolute;
    left: 0;
    top: 0;
    width: 17.5rem;
    height: 23rem;
    padding: 0;
    border: none;
    background: var(--pink-lt);
    border-radius: 10px;
    overflow: hidden;
    cursor: pointer;
    will-change: transform, opacity, filter;
  }
  .slide img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 10px;
    user-select: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .slide { filter: none !important; }
  }
  @media (max-width: 1023px) {
    .carou { display: none; }
  }
</style>
