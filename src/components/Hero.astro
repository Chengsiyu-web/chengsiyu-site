---
import { site } from "../config";
const socials = site.socials;
---

<section class="cover">
  <div class="cover-inner">
    <div class="issue mono reveal">{site.issue}</div>
    <h1 class="reveal">
      {site.greetingLead} <span class="pink-word">{site.pinkWord}</span>
    </h1>
    <p class="intro reveal">
      我是<strong>{site.lastName}{site.firstName}</strong>，{site.tagline}
    </p>
    <p class="now reveal">
      <span class="now-label mono">NOW</span>{site.now}
    </p>
    <ul class="socials reveal">
      {
        socials.map((s) => (
          <li>
            <span class="mono social-label">{s.label}</span>
            <a href={s.href} class="social-link u-underline">{s.display}</a>
          </li>
        ))
      }
    </ul>
    <a href="#work-panel" class="scroll-cue mono" aria-label="向下滚动查看项目">SCROLL ↓</a>
  </div>
</section>

<style>
  .cover {
    background: var(--ink);
    color: var(--paper);
    min-height: 100dvh;
    display: flex;
    align-items: center;
    position: relative;
  }
  .cover-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 120px 40px;
    width: 100%;
  }
  .issue {
    display: inline-block;
    background: var(--pink);
    color: var(--ink);
    padding: 6px 14px;
    margin-bottom: 40px;
  }
  h1 {
    font-size: clamp(3.5rem, 10vw, 8.5rem);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.01em;
  }
  .pink-word { color: var(--pink); }
  .intro {
    margin-top: 40px;
    font-size: 1.05rem;
    color: var(--gray-body-dark);
    max-width: 34em;
  }
  .intro strong { color: var(--paper); font-weight: 600; }
  .now {
    margin-top: 20px;
    font-size: 0.9rem;
    color: var(--gray-dim-dark);
    max-width: 34em;
  }
  .now-label {
    color: var(--pink);
    margin-right: 10px;
    letter-spacing: 0.1em;
    font-size: 0.7rem;
  }
  .socials {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 16px 40px;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--hairline-dark);
    max-width: 34em;
  }
  .socials li { display: flex; align-items: baseline; gap: 12px; }
  .social-label {
    color: var(--gray-dim-dark);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
  }
  .social-link { color: var(--paper); transition: color 0.2s var(--ease-out); }
  .social-link:hover { color: var(--pink); }
  .scroll-cue {
    position: absolute;
    bottom: 32px;
    left: 40px;
    color: var(--gray-dim-dark);
  }
  @media (max-width: 768px) {
    .cover-inner { padding: 96px 20px; }
    .scroll-cue { left: 20px; }
  }
</style>
