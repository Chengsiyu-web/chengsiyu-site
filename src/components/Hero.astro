---
import { site } from "../config";
import Gallery from "./Gallery.astro";
const socials = site.socials;
---

<section class="cover">
  <div class="cover-inner">
    <div class="cover-main">
      <div class="issue mono reveal">{site.issue}</div>
      <h1 class="reveal reveal-mask">
        <span class="mask-line">
          <span class="mask-inner">{site.greetingLead} <span class="pink-word">{site.pinkWord}</span></span>
        </span>
      </h1>
      <p class="intro reveal">
        我是<strong>程思语</strong>，{site.tagline}
      </p>
      <p class="now reveal">
        <span class="now-label mono">RECENTLY</span>{site.now}
      </p>
      <ul class="socials reveal">
        {
          socials.map((s) => (
            <li>
              <span class="mono social-label">{s.label}</span>
              <a href={s.href} class="social-link u-underline">{s.display}</a>
            </li>
          ))
        }
      </ul>
    </div>
    <Gallery />
    <a href="#work-panel" class="scroll-cue mono" data-next-screen="1" aria-label="向下查看项目">SCROLL ↓</a>
  </div>
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {[0, 1].map((n) => (
        <span class="marquee-copy">
          AI PRODUCT <i>·</i> AGENT <i>·</i> 跨境电商 <i>·</i> 意大利交换 <i>·</i> 舞蹈 <i>·</i> VIBE CODING <i>·</i>
        </span>
      ))}
    </div>
  </div>
</section>

<style>
  .cover {
    background: var(--ink);
    color: var(--paper);
    height: 100%;
    display: flex;
    align-items: center;
    position: relative;
  }
  .cover-inner {
    max-width: 78rem;
    margin: 0 auto;
    padding: 100px 40px;
    width: 100%;
    display: flex;
    align-items: center;
    gap: 64px;
  }
  .cover-main { flex: 1; min-width: 0; }
  .issue {
    display: inline-block;
    background: var(--pink);
    color: var(--ink);
    padding: 6px 14px;
    margin-bottom: 40px;
  }
  h1 {
    font-size: clamp(3.5rem, 10vw, 8.5rem);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.01em;
  }
  .pink-word { color: var(--pink); }
  .intro {
    margin-top: 40px;
    font-size: 1.05rem;
    color: var(--gray-body-dark);
    max-width: 34em;
  }
  .intro strong { color: var(--paper); font-weight: 600; }
  .now {
    margin-top: 20px;
    font-size: 0.9rem;
    color: var(--gray-dim-dark);
    max-width: 34em;
  }
  .now-label {
    color: var(--pink);
    margin-right: 10px;
    letter-spacing: 0.1em;
    font-size: 0.7rem;
  }
  .socials {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 16px 40px;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--hairline-dark);
    max-width: 34em;
  }
  .socials li { display: flex; align-items: baseline; gap: 12px; }
  .social-label {
    color: var(--gray-dim-dark);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
  }
  .social-link { color: var(--paper); transition: color 0.2s var(--ease-out); }
  .social-link:hover { color: var(--pink); }
  .scroll-cue {
    position: absolute;
    bottom: 76px;
    left: 40px;
    color: var(--gray-dim-dark);
  }
  .marquee {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    border-top: 1px solid var(--hairline-dark);
    overflow: hidden;
    padding: 13px 0;
  }
  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 36s linear infinite;
  }
  .marquee-copy {
    font-family: var(--font-display);
    font-size: 13px;
    letter-spacing: 0.22em;
    white-space: nowrap;
    color: var(--gray-dim-dark);
  }
  .marquee-copy i { font-style: normal; color: var(--pink); padding: 0 1.6em; }
  @media (hover: hover) and (pointer: fine) {
    .marquee:hover .marquee-track { animation-play-state: paused; }
  }
  @keyframes marquee {
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track { animation: none; }
  }
  @media (max-width: 768px) {
    .cover-inner { padding: 96px 20px; }
    .scroll-cue { left: 20px; }
  }
</style>
