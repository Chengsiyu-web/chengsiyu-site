---
interface Props {
  name: string;
  description: string;
  href: string;
  year: string;
  image?: string;
}
const { name, description, href, year, image } = Astro.props;
---

<a class="project-card reveal" href={href} target="_blank" rel="noopener noreferrer">
  {
    image ? (
      <div class="thumb">
        <img src={image} alt={`${name}首页截图`} loading="lazy" width="1200" height="750" />
      </div>
    ) : null
  }
  <div class="body">
    <div class="mono meta">
      <span class="year">{year}</span>
      <span class="arrow" aria-hidden="true">↗</span>
    </div>
    <h3 class="name">{name}</h3>
    <p class="desc">{description}</p>
  </div>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--hairline);
  }
  .thumb {
    overflow: hidden;
    border-bottom: 1px solid var(--hairline);
    aspect-ratio: 16 / 9;
    max-height: 220px;
    background: var(--paper);
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .project-card:hover .thumb img { transform: scale(1.03); }
  }
  .body { padding: 24px 24px 28px; display: flex; flex-direction: column; min-width: 0; }
  .meta {
    display: flex;
    justify-content: space-between;
    color: var(--gray-mid);
    margin-bottom: 10px;
  }
  .arrow { transition: transform 0.24s var(--ease-out); }
  .name { font-size: 1.4rem; }
  .project-card:hover .name { text-decoration: underline; text-decoration-color: var(--pink); text-decoration-thickness: 2px; text-underline-offset: 6px; }
  .project-card:hover .arrow { transform: translate(4px, -4px); color: var(--pink); }
  .project-card:active .name { opacity: 0.7; }
  .desc { margin-top: 8px; color: var(--gray-mid); font-size: 14px; }
</style>
