---
interface Props {
  title: string;
  excerpt: string;
  date: string;
  category: string;
  tags: string[];
  href: string;
}
const { title, excerpt, date, category, tags, href } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// 分类色彩语言：随笔 = pink 系（生活感）；AI 洞察 / 研究 = 衬线深色块（工作感）
const isAI = /AI|研究/.test(category);
const catClass = isAI ? "cat cat-ai" : "cat cat-essay";
---

<article class="article-card reveal">
  <div class="meta mono">
    <time datetime={date}>{date}</time>
    <span class="sep">/</span>
    <a href={`${base}/posts/?cat=${category}`} class={catClass}>{category}</a>
    <span class="sep">/</span>
    <span class="tags">{tags.map((t) => `#${t}`).join(" ")}</span>
  </div>
  <h3 class="title"><a href={href} class="u-underline">{title}</a></h3>
  <p class="excerpt">{excerpt}</p>
</article>

<style>
  .article-card {
    border-top: 1px solid var(--hairline);
    padding: 32px 0 40px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: baseline;
    color: var(--gray-mid);
    margin-bottom: 14px;
  }
  .sep { color: var(--hairline); }

  /* 随笔：pink 底胶囊（生活随笔的柔和） */
  .cat-essay {
    color: var(--pink-deep);
    background: var(--pink-lt);
    padding: 1px 10px;
    border-radius: 999px;
    transition: background 0.24s var(--ease-out);
  }
  .cat-essay:hover { background: var(--pink); }

  /* AI 洞察 / 研究：ink 底反白胶囊（工作研究的分量） */
  .cat-ai {
    color: var(--bg-white);
    background: var(--ink);
    padding: 1px 10px;
    border-radius: 999px;
    transition: background 0.24s var(--ease-out);
  }
  .cat-ai:hover { background: var(--pink-deep); }

  .title { font-size: clamp(1.15rem, 1.8vw, 1.3rem); text-wrap: pretty; }
  .title a { font-weight: 600; }
  .excerpt {
    margin-top: 10px;
    color: var(--gray-mid);
    max-width: 62ch;
  }
  @media (max-width: 768px) {
    .excerpt {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  }
</style>
