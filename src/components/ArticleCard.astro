---
interface Props {
  title: string;
  excerpt: string;
  date: string;
  category: string;
  tags: string[];
  href: string;
}
const { title, excerpt, date, category, tags, href } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<article class="article-card reveal">
  <div class="meta mono">
    <time datetime={date}>{date}</time>
    <span class="sep">/</span>
    <a href={`${base}/posts/?cat=${category}`} class="cat" data-cat-link>{category}</a>
    <span class="sep">/</span>
    <span class="tags">{tags.map((t) => `#${t}`).join(" ")}</span>
  </div>
  <h3 class="title"><a href={href} class="u-underline">{title}</a></h3>
  <p class="excerpt">{excerpt}</p>
</article>

<style>
  .article-card {
    border-top: 1px solid var(--hairline);
    padding: 32px 0 40px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: baseline;
    color: var(--gray-mid);
    margin-bottom: 14px;
  }
  .sep { color: var(--hairline); }
  .cat { color: var(--ink); }
  .cat:hover { color: var(--pink); }
  .title { font-size: clamp(1.15rem, 1.8vw, 1.3rem); text-wrap: pretty; }
  .title a { font-weight: 600; }
  .excerpt {
    margin-top: 10px;
    color: var(--gray-mid);
    max-width: 62ch;
  }
  @media (max-width: 768px) {
    .excerpt {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  }
</style>
