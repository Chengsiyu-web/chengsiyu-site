---
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import projects from "../../data/projects.json";
import { site } from "../../config";
const NAME = `${site.firstName} ${site.lastName}`.toUpperCase();
---

<Base title={`项目 — ${NAME}`}>
  <main class="page-main">
    <header class="page-head reveal">
      <p class="mono kicker">WORK</p>
      <h1>项目</h1>
      <p class="count mono">{projects.length} 个 · 点击直达</p>
    </header>
    <div class="list">
      {projects.map((p) => <ProjectCard {...p} />)}
    </div>
  </main>
</Base>

<style>
  .page-main {
    max-width: 60rem;
    margin: 0 auto;
    padding: 96px 40px 0;
  }
  .page-head h1 {
    font-size: clamp(2.8rem, 6vw, 4.5rem);
    margin: 12px 0 8px;
  }
  .kicker { color: var(--pink); }
  .count { color: var(--gray-mid); }
  .list {
    margin-top: 40px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    align-items: stretch;
  }
  @media (max-width: 768px) {
    .page-main { padding: 56px 20px 0; }
    .list { grid-template-columns: 1fr; gap: 16px; }
  }
</style>
