---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import ArticleCard from "../components/ArticleCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import projects from "../data/projects.json";
import { site } from "../config";
const NAME = `${site.firstName} ${site.lastName}`.toUpperCase();

const posts = (await getCollection("posts")).sort((a, b) =>
  b.data.date.localeCompare(a.data.date)
);
const latest = posts.slice(0, 3);
---

<Base title={`${NAME} — 首页`}>
  <Hero />

  <main class="home-main">
    <section class="section">
      <header class="section-head reveal">
        <h2>在做的项目</h2>
        <a href="/projects/" class="mono u-underline">全部项目 →</a>
      </header>
      <div class="grid">
        {projects.map((p) => <ProjectCard {...p} />)}
      </div>
    </section>

    <section id="latest" class="section">
      <header class="section-head reveal">
        <h2>最近写作</h2>
        <a href="/posts/" class="mono u-underline">全部文章 →</a>
      </header>
      <div class="list">
        {
          latest.map((p) => (
            <ArticleCard
              title={p.data.title}
              excerpt={p.data.excerpt}
              date={p.data.date}
              category={p.data.category}
              tags={p.data.tags}
              href={`/posts/${p.id}/`}
            />
          ))
        }
      </div>
    </section>
  </main>
</Base>

<style>
  .home-main {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 40px;
  }
  .section { margin-top: 128px; }
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 64px;
  }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 8px;
  }
  .section-head h2 { font-size: 2rem; }
  .section-head a { color: var(--gray-mid); }
  .section-head a:hover { color: var(--ink); }
  @media (max-width: 768px) {
    .home-main { padding: 0 20px; }
    .section { margin-top: 72px; }
    .grid { grid-template-columns: 1fr; column-gap: 0; }
    .section-head h2 { font-size: 1.6rem; }
  }
</style>
