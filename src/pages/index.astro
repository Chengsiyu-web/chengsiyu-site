---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import ArticleCard from "../components/ArticleCard.astro";
import Musings from "../components/Musings.astro";
import ProjectCard from "../components/ProjectCard.astro";
import projects from "../data/projects.json";
import { site } from "../config";
const NAME = `${site.firstName} ${site.lastName}`.toUpperCase();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const posts = (await getCollection("posts")).sort((a, b) =>
  b.data.date.localeCompare(a.data.date)
);
const latest = posts.slice(0, 3);
---

<Base title={`${NAME} — 首页`}>
  <div class="screens" id="homeScreens">
    <section class="screen-panel screen-active hero-panel" data-panel="hero">
      <Hero />
    </section>

    <section class="screen-panel" data-panel="work" id="work-panel">
      <div class="panel-scroll"><div class="panel-inner">
        <header class="section-head">
          <div>
            <div class="work-label mono">Things I've built and shipped.</div>
            <h2>在做的项目</h2>
          </div>
          <a href={`${base}/projects/`} class="u-underline panel-more mono">全部项目 →</a>
        </header>
        <div class="grid">
          {projects.map((p) => <ProjectCard {...p} />)}
        </div>
        <div class="panel-nav">
          <span></span>
          <button class="panel-next" data-next-screen="2">My Thinking <i>↓</i></button>
        </div>
      </div></div>
    </section>

    <section class="screen-panel" data-panel="thinking">
      <div class="panel-scroll panel-center"><div class="panel-inner">
        <Musings />
        <div class="panel-nav">
          <button class="panel-prev" data-next-screen="1">↑ 项目</button>
          <button class="panel-next" data-next-screen="3">最近写作 <i>↓</i></button>
        </div>
      </div></div>
    </section>

    <section class="screen-panel" data-panel="writing">
      <div class="panel-scroll"><div class="panel-inner">
        <header class="section-head">
          <div>
            <div class="work-label mono">Words that stayed.</div>
            <h2>最近的写作</h2>
          </div>
          <a href={`${base}/posts/`} class="u-underline panel-more mono">全部文章 →</a>
        </header>
        <div class="list">
          {
            latest.map((p) => (
              <ArticleCard
                title={p.data.title}
                excerpt={p.data.excerpt}
                date={p.data.date}
                category={p.data.category}
                tags={p.data.tags}
                href={`${base}/posts/${p.id}/`}
              />
            ))
          }
        </div>
        <div class="panel-nav">
          <button class="panel-prev" data-next-screen="2">↑ My Thinking</button>
          <span></span>
        </div>
      </div></div>
    </section>
  </div>
</Base>

<script>
  // 分屏切换（源：老 Portfolio 机制：面板叠放 + 面板内滚动，文档本身不滚）
  const wrap = document.getElementById("homeScreens");
  const panels = Array.from(document.querySelectorAll(".screen-panel"));
  let cur = 0;
  let busy = false;
  function go(idx) {
    if (busy || idx === cur || idx < 0 || idx >= panels.length) return;
    busy = true;
    const from = panels[cur];
    const to = panels[idx];
    const dir = idx > cur ? 1 : -1;
    to.style.setProperty("--dir", dir);
    from.style.setProperty("--dir", dir);
    to.classList.remove("screen-leaving");
    // 无过渡把待入面板摆到入场起点（60% 视口外），下一帧再放开过渡推入
    to.style.transition = "none";
    to.style.transform = "translateY(" + dir * 60 + "%)";
    to.style.opacity = "0";
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        to.style.transition = "";
        from.classList.remove("screen-active");
        from.classList.add("screen-leaving");
        to.classList.add("screen-active");
        to.style.transform = "";
        to.style.opacity = "";
        cur = idx;
        setTimeout(() => {
          from.classList.remove("screen-leaving");
          busy = false;
        }, 680);
      });
    });
  }
  document.querySelectorAll("[data-next-screen]").forEach((btn) => {
    btn.addEventListener("click", () => go(Number(btn.dataset.nextScreen)));
  });
  // 面板内滚动：滚到底继续向下 = 下一屏；滚到顶继续向上 = 上一屏；320ms 锁 = 阻力感
  // hero 屏无内部滚动，直接翻页
  let wheelLock = 0;
  // 翻入面板后的最小停留时间：短内容面板（不足一屏）不设防会被连续滚轮直接穿过
  let settleUntil = 0;
  wrap.addEventListener("wheel", (e) => {
    const now = Date.now();
    if (now - wheelLock < 320 || now < settleUntil || busy) return;
    const panel = panels[cur];
    if (panel.dataset.panel === "hero") {
      if (e.deltaY > 0) { wheelLock = now; settleUntil = now + 900; go(cur + 1); }
      return;
    }
    const el = panel.querySelector(".panel-scroll") || panel;
    const atBottom = el.scrollTop + el.clientHeight >= el.scrollHeight - 4;
    const atTop = el.scrollTop <= 0;
    if (e.deltaY > 0 && atBottom) {
      wheelLock = now;
      settleUntil = now + 900;
      go(cur + 1);
    } else if (e.deltaY < 0 && atTop) {
      wheelLock = now;
      settleUntil = now + 900;
      go(cur - 1);
    }
  }, { passive: true });
</script>

<style>
  .screens {
    background: var(--bg);
    position: relative;
    height: calc(100dvh - 60px);
    overflow: hidden;
  }
  /* 面板叠放：全部绝对定位，不占文档流——文档本身无滚动余量 */
  .screen-panel {
    position: absolute;
    inset: 0;
    height: 100%;
  }
  .hero-panel { overflow: hidden; }
  .panel-center {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .panel-scroll {
    height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
  }
  .panel-scroll::-webkit-scrollbar { width: 4px; }
  .panel-scroll::-webkit-scrollbar-thumb { background: var(--hairline); border-radius: 2px; }
  .panel-inner {
    max-width: 68rem;
    margin: 0 auto;
    padding: 72px 95px 56px;
    width: 100%;
  }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    margin-bottom: 32px;
  }
  .work-label { color: var(--gray-light); margin-bottom: 8px; display: block; }
  .section-head h2 { font-size: clamp(1.9rem, 4vw, 2.5rem); }
  .panel-more { color: var(--gray-mid); }
  .panel-more:hover { color: var(--pink-deep); }

  /* 项目卡：2 列但整体限宽，间距加大（不再贪满） */
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 34rem));
    justify-content: center;
    gap: 32px 40px;
    padding: 0 41px;
  }

  .panel-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 56px;
    gap: 16px;
  }
  .panel-prev, .panel-next {
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    color: var(--gray-light);
    padding: 10px 4px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.25s var(--ease-out);
  }
  .panel-prev i, .panel-next i { font-style: normal; transition: transform 0.3s var(--ease-out); }
  .panel-next:hover { color: var(--pink-deep); }
  .panel-next:hover i { transform: translateY(3px); }
  .panel-prev:hover { color: var(--pink-deep); }
  .panel-prev:hover i { transform: translateY(-3px); }

  @media (max-width: 768px) {
    .panel-inner { padding: 48px 20px 40px; }
    .grid { grid-template-columns: 1fr; gap: 24px; }
    .section-head { flex-direction: column; align-items: flex-start; gap: 8px; }
  }
</style>
