---
import { site } from "../../config";
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const NAME = `${site.firstName} ${site.lastName}`.toUpperCase();
const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={`${post.data.title} — ${NAME}`} description={post.data.excerpt}>
  <main class="post-main">
    <header class="post-head reveal">
      <div class="meta mono">
        <time datetime={post.data.date}>{post.data.date}</time>
        <span>/</span>
        <span>{post.data.category}</span>
        <span>/</span>
        <span>{post.data.tags.map((t) => `#${t}`).join(" ")}</span>
      </div>
      <h1>{post.data.title}</h1>
    </header>
    <article class="prose">
      <Content />
    </article>
    <a href="/posts/" class="mono u-underline back">← 返回全部文章</a>
  </main>
</Base>

<style>
  .post-main {
    max-width: 44rem;
    margin: 0 auto;
    padding: 96px 24px 0;
  }
  .post-head h1 {
    font-size: clamp(2rem, 5vw, 3.2rem);
    margin-top: 16px;
  }
  .meta { color: var(--gray-mid); display: flex; gap: 10px; flex-wrap: wrap; }
  .prose {
    margin-top: 48px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 17px;
    line-height: 2.1;
    letter-spacing: 0.01em;
  }
  .prose :global(p) { margin-bottom: 1.4em; }
  .prose :global(h2) {
    font-family: var(--font-display);
    font-weight: 600;
    margin: 3em 0 1em;
    font-size: 1.45rem;
  }
  .prose :global(img) {
    display: block;
    width: 100%;
    margin: 2.4em auto;
    border: 1px solid var(--hairline);
  }
  .prose :global(small) {
    display: block;
    text-align: center;
    color: var(--gray-mid);
    font-family: var(--font-body);
    font-size: 13px;
    letter-spacing: 0.06em;
    margin: -1.4em auto 2.8em;
  }
  .prose :global(blockquote) {
    border-left: none;
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    padding: 0.6em 0;
    margin: 2em 0;
    color: var(--gray-mid);
    font-size: 1.05em;
  }
  .back { display: inline-block; margin-top: 64px; color: var(--gray-mid); }
  .back:hover { color: var(--ink); }
</style>
